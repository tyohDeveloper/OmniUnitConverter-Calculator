{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "client/index.html",
    "scripts/*.mjs",
    "scripts/*.ts",
    "scripts/eslint-rules/*.js",
    "tests/**/*.test.ts",
    "tests/e2e/**/*.ts"
  ],
  "project": [
    "client/src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts,js}",
    "tests/**/*.ts"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "unlisted": "warn",
    "binaries": "off",
    "unresolved": "warn",
    "duplicates": "warn",
    "enumMembers": "off"
  }
}
