{
  "name": "omniunit",
  "version": "5.2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5000",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "check": "tsc --noEmit",
    "lint:size": "node scripts/lint-size.mjs",
    "lint": "eslint client/src",
    "lint:fix": "eslint client/src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "build:bundle": "vite build",
    "minify:artifact": "node scripts/minify-artifact.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build:fast": "vite build",
    "build": "npm run check && npm run lint:size && npm run lint && npm run lint:dead && npm run lint:secrets && npm run test:run && npm run build:bundle && npm run minify:artifact && npm run verify:build",
    "lint:dead": "knip",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --failOn 'GPL-2.0;GPL-3.0;AGPL-3.0;LGPL-3.0' --markdown --out THIRD_PARTY_LICENSES.md",
    "licenses:check": "npm run licenses && git diff --exit-code -- THIRD_PARTY_LICENSES.md",
    "lint:secrets": "secretlint \"**/*\""
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "jsdom": "^29.0.2",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "temporal-polyfill": "^1.0.3",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.4",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.4.4",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@secretlint/secretlint-rule-preset-recommend": "^12.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-minifier-terser": "^7.2.0",
    "knip": "^6.44.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "postcss": "^8.5.6",
    "sax": "^1.6.1",
    "secretlint": "^12.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
